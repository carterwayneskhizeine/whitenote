# ========================================
# WhiteNote 环境配置模板
# 复制此文件为 .env 并填入实际值
# ========================================

# ========================================
# 应用配置
# ========================================
NODE_ENV=development
PORT=3005
NEXT_PUBLIC_APP_URL="http://localhost:3005"

# ========================================
# NextAuth 配置
# ========================================
# URL of your Next.js application
AUTH_URL="http://localhost:3005"
# Legacy support (deprecated in NextAuth v5)
NEXTAUTH_URL="http://localhost:3005"
# Secret key for JWT token encryption (generate with: openssl rand -base64 32)
NEXTAUTH_SECRET="your-super-secret-key-change-this"

# ========================================
# 数据库连接 (SQLite)
# ========================================
DATABASE_URL="file:./data/whitenote.db"

# ========================================
# 加密密钥 (REQUIRED)
# Generate with: openssl rand -base64 32
# Used to encrypt sensitive data (API keys) before storing in database
# ========================================
ENCRYPTION_KEY="your-32-byte-base64-encryption-key-here"

# ========================================
# OpenClaw Gateway 配置 (可选)
# ========================================
OPENCLAW_GATEWAY_URL="ws://localhost:18789"
OPENCLAW_TOKEN="your-openclaw-token-here"

# ========================================
# Hermes Agent 配置 (可选)
# ========================================
HERMES_API_URL="http://localhost:8642"
HERMES_DASHBOARD_URL="http://localhost:9119"
HERMES_API_KEY="your-hermes-api-key-here"

# ========================================
# 文件监听器配置
# ========================================
FILE_WATCHER_ENABLED=false
# FILE_WATCHER_DIR=./data/link_md

# ========================================
# 默认用户
# ========================================
DEFAULT_USER_EMAIL=your-email@example.com

# ========================================
# 文件上传 (Docker 部署时可覆盖为绝对路径)
# ========================================
# UPLOAD_DIR=/app/data/uploads
